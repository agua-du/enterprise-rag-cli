RAG_ENVIRONMENT=development

RAG_DATA_DIR=data/enterprise-rag-bench
RAG_REPORTS_DIR=reports

RAG_POSTGRES_HOST=localhost
RAG_POSTGRES_PORT=5432
RAG_POSTGRES_USER=rag
RAG_POSTGRES_PASSWORD=replace-with-a-local-password
RAG_POSTGRES_DATABASE=enterprise_rag


RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150

RAG_DASHSCOPE_API_KEY=
RAG_DASHSCOPE_BASE_HTTP_API_URL=https://你的业务空间域名/api/v1
RAG_DASHSCOPE_COMPATIBLE_BASE_URL=替换成同一业务空间的_OpenAI_兼容地址

RAG_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_BATCH_SIZE=20

RAG_MILVUS_URI=http://localhost:19530
RAG_MILVUS_COLLECTION=document_chunks

RAG_GENERATION_MODEL=qwen3.8-flash
RAG_DEFAULT_TOP_K=5
